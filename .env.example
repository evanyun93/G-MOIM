# 복사해서 .env로 쓴다. .env는 git에 올라가지 않는다.
# 주의: wrangler·astro 로컬 실행이 .env를 Worker 환경 변수로 자동으로 읽는다. 운영 값을 넣지 않는다.

# 로컬 Docker DB (npm run db:up). 마이그레이션·개발 기본 대상
DATABASE_URL=postgres://gmoim:gmoim_local_only@127.0.0.1:5432/gmoim

# 운영 Neon 값은 .env.neon에 따로 둔다 (자동으로 읽히지 않음, git 제외).
#   NEON_DATABASE_URL=...            풀링 주소
#   NEON_DATABASE_URL_UNPOOLED=...   직접 주소 — Hyperdrive·pg_dump용
# 운영 마이그레이션: DATABASE_URL=<UNPOOLED 값> MIGRATE_REMOTE=yes npm run db:migrate
